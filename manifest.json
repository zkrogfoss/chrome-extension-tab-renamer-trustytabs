{
  "manifest_version": 3,
  "name": "TrustyTabs",
  "version": "1.2.0",
  "description": "Rename any tab. Every tab of the same page gets the name, even after a reload.",
  "permissions": ["storage", "activeTab"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rename this tab",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Rename this tab" }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["key.js", "content.js"], "run_at": "document_idle" }
  ]
}
